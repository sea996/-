port: 7890
socks-port: 7891
allow-lan: true
mode: Rule
log-level: info
external-controller: 127.0.0.1:9090

dns:
  enable: true
  ipv6: false
  default-nameserver:
    - 223.5.5.5
    - 114.114.114.114
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query

proxy-providers:
  机场:
    type: http
    url: "https://xfx9k.no-mad-sub.one/link/Z7v9bsLFqKWZDL81?clash=3&extend=1"
    interval: 86400
    path: ./proxy_provider/jc.yaml
    udp: true
    health-check:
      enable: true
      interval: 600
      url: http://connectivitycheck.platform.hicloud.com/generate_204

proxies:
  - name: "日本付款"
    type: socks5
    server: 192.168.2.2
    port: 5501
    udp: true

proxy-groups:
  - name: "机场中转"
    type: select
    use:
      - "机场"
  - name: "礼品卡付款"
    type: select
    proxies:
      - "日本付款"
      - "机场中转"
      - DIRECT

  - name: "主线路"
    type: select
    proxies:
      - "礼品卡付款"
      - "机场中转"
      - DIRECT

